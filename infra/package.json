{
  "name": "registre-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for Registre (Continuous Audit-Evidence Registry on Amazon Bedrock).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "npx cdk synth --quiet",
    "diff": "npx cdk diff",
    "deploy": "npx cdk deploy --all --require-approval never",
    "destroy": "npx cdk destroy --all"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
