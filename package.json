{
  "name": "registre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Continuous audit-evidence registry for AWS MSP partners, built on Amazon Bedrock.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "demo": "node tools/demo/main.ts",
    "demo:generate": "node tools/demo/generate.ts",
    "eval:local": "node tools/eval/score.ts",
    "api": "node src/api/server.ts",
    "check:sizes": "node tools/quality/checkSizes.ts",
    "check:wording": "node tools/quality/checkWording.ts",
    "verify": "npm run typecheck && npm run test && npm run check:sizes && npm run check:wording"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.930.0",
    "@aws-sdk/client-bedrock-runtime": "^3.930.0",
    "@aws-sdk/client-dynamodb": "^3.930.0",
    "@aws-sdk/client-s3": "^3.930.0",
    "@aws-sdk/client-sesv2": "^3.930.0",
    "@aws-sdk/lib-dynamodb": "^3.930.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  }
}
